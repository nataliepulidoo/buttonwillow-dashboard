{
  "name": "buttonwillow-weather-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/audit-private-data.mjs && tsc -b && vite build && node scripts/audit-private-data.mjs dist",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "audit:deployment": "node scripts/audit-private-data.mjs dist"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "lucide-react": "^0.468.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
